# Block Convey PRISM tracing (leave blank -> "tracing disabled")
PRISMTRACE_HOST=https://prism.blockconvey.com
PRISMTRACE_PROJECT_ID=
PRISMTRACE_API_KEY=

# NicrronNinoo AI provider: Nicrron OpenAI-compatible gateway (no key -> mock provider)
NICRRONNINOO_BASE_URL=https://api.nicrron.ai/v1
NICRRONNINOO_API_KEY=
NICRRONNINOO_MODEL=anthropic/claude-haiku-4-5
NICRRONNINOO_STT_MODEL=openai/whisper-1
NICRRONNINOO_IMAGE_MODEL=google/nano-banana
# image generation costs ~$0.04 per SOS; set 0 to use the local sketch instead
NICRRONNINOO_REBUILD=1

# AI results below this confidence are labeled "unverified"
AI_CONFIDENCE_THRESHOLD=0.7
